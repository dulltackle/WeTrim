{
  "name": "WeTrim",
  "version": "1.0.0",
  "description": "手动清洗微信公众号文章，导出 Markdown 和图片。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node test/check-dom-access.mjs && node test/verify-csp.mjs",
    "check-dom": "node test/check-dom-access.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer": "^25.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
