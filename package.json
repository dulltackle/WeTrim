{
  "name": "WeTrim",
  "version": "1.0.0",
  "description": "手动清洗微信公众号文章，导出 Markdown 和图片。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node test/check-dom-access.mjs && node test/verify-csp.mjs",
    "check-dom": "node test/check-dom-access.mjs",
    "check:dom": "node test/check-dom-access.mjs",
    "verify:issue24": "node test/verify-issue24.mjs",
    "verify:issue25": "node test/verify-issue25.mjs",
    "verify:issue26": "node test/verify-issue26.mjs",
    "verify:issue27": "node test/verify-issue27.mjs",
    "verify:issue28": "node test/verify-issue28.mjs",
    "verify:issue29": "node test/verify-issue29.mjs && node test/verify-issue29-reading-position.mjs",
    "verify:issue30": "node test/verify-issue30.mjs",
    "verify:issue31": "node test/verify-issue31.mjs",
    "verify:issue32": "node test/verify-issue32.mjs",
    "verify:issue33": "node test/verify-issue33.mjs",
    "verify:image-referer": "node test/verify-image-referer.mjs",
    "typecheck": "tsc --noEmit",
    "verify:issue34": "node test/verify-issue34.mjs",
    "verify:issue35": "node test/verify-issue35.mjs",
    "verify:issue36": "node test/verify-issue36.mjs",
    "verify:issue37": "node test/verify-issue37.mjs",
    "verify:issue38": "node test/verify-issue38.mjs",
    "verify:issue39": "node test/verify-issue39.mjs",
    "version:set": "node scripts/release-version.mjs set",
    "version:check": "node scripts/release-version.mjs check",
    "package:release": "node scripts/release-version.mjs check && python3 scripts/package-release.py",
    "test:release": "node --test test/release.test.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "test:permissions": "node --test test/permissions.test.mjs",
    "verify:issue61": "node test/verify-issue61.mjs",
    "verify:issue60": "node test/verify-issue60.mjs",
    "verify:issue59": "node test/verify-issue59.mjs",
    "verify:issue65": "node test/verify-issue65.mjs",
    "verify:issue62": "node test/verify-issue62.mjs",
    "verify:issue63": "node test/verify-issue63.mjs",
    "verify:issue58": "node test/verify-issue58.mjs",
    "verify:pr": "node scripts/verify-pr.mjs",
    "verify:issue64": "node test/verify-issue64.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer": "^25.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
