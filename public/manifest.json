{
  "manifest_version": 3,
  "name": "WeTrim",
  "version": "1.0.0",
  "description": "手动清洗微信公众号文章，导出 Markdown 和图片。",
  "action": {
    "default_title": "用 WeTrim 清洗这篇文章"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://mmbiz.qpic.cn/*",
    "*://mmbiz.qlogo.cn/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
